# Copy to .env.local for local development. Never commit real values.
# Local auth uses Application Default Credentials: gcloud auth application-default login

GOOGLE_CLOUD_PROJECT=
# Region for Gemini calls, or "global". Verify each model below is available there (spikes/0-list-models.ts).
GOOGLE_CLOUD_LOCATION=global

# Model IDs. Pick from the output of `npm run spike:models`.
GEMINI_MODEL=
GEMINI_VIDEO_MODEL=
GEMINI_TTS_MODEL=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

FIRESTORE_DATABASE=(default)
GCS_BUCKET=

# Signs the anonymous workspace cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKSPACE_COOKIE_SECRET=
DEMO_WORKSPACE_ID=demo-maya

# Only if the enterprise (Vertex) endpoint rejects YouTube URLs. Server-side only.
GEMINI_API_KEY=

# Optional Google sign-in (Firebase Authentication). Public web-app config from
# Firebase console > Project settings > Your apps > Corvus web. Sign-in stays hidden until all three are set.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
